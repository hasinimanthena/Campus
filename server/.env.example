# CampusPath Environment Configuration Example
# Copy this file to .env inside the server folder: `cp server/.env.example server/.env`

# Backend Server Configuration
PORT=5001
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# 1. Official PhonePe Payment Gateway Credentials
# ----------------------------------------------------------------------------
# For Testing / Sandbox (UAT):
# Merchant ID: PGTESTPAYUAT
# Salt Key: 099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
# Salt Index: 1
# Env: SANDBOX
#
# For Live Production:
# Onboard via PhonePe Business (https://business.phonepe.com/)
# Obtain production Merchant ID, Salt Key, and Salt Index from the PhonePe Dashboard.
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=SANDBOX

# ----------------------------------------------------------------------------
# 2. Google OAuth 2.0 Credentials
# ----------------------------------------------------------------------------
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# ----------------------------------------------------------------------------
# 3. GitHub OAuth Credentials
# ----------------------------------------------------------------------------
# Create OAuth App in GitHub Developer Settings:
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:5001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5001/api/auth/github/callback
